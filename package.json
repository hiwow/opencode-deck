{
  "name": "opencode-deck",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local web dashboard for monitoring and steering up to four OpenCode v2 projects.",
  "repository": {
    "type": "git",
    "url": "https://github.com/hiwow/opencode-deck.git"
  },
  "homepage": "https://github.com/hiwow/opencode-deck#readme",
  "bugs": {
    "url": "https://github.com/hiwow/opencode-deck/issues"
  },
  "keywords": [
    "opencode",
    "dashboard",
    "react",
    "typescript",
    "tailwindcss"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c yellow,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "serve": "tsx server/index.ts",
    "start": "npm run build && npm run serve",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@radix-ui/react-collapsible": "^1.2.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "^9.1.2",
    "dompurify": "^3.2.4",
    "lucide-react": "^0.468.0",
    "marked": "^15.0.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.19.2",
    "tw-animate-css": "^1.4.0",
    "vite": "^6.0.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "typescript": "^5.7.2"
  }
}
